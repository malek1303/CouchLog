# CouchLog Environment Variables
# Copy this file to .env.local and fill in your values

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER expose to the browser
# Used only in server-side routes (cron, media inserts)
SUPABASE_SERVICE_ROLE_KEY=

# ── TMDB ──────────────────────────────────────────────────────
# Your TMDB v4 Read Access Token (Bearer token)
# Found in: themoviedb.org → Settings → API → Read Access Token
# NEVER expose to the browser
TMDB_READ_ACCESS_TOKEN=

# ── Cron Security ─────────────────────────────────────────────
# Shared secret to authenticate the Vercel Cron → /api/cron/check-new-episodes
# Set the same value in your Vercel environment variables
# Generate with: openssl rand -base64 32
CRON_SECRET=
